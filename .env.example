# Copy to .env (gitignored) and fill in. Never commit .env.
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional abuse controls (ticket 18). Set TURNSTILE_SECRET_KEY to enforce
# the Cloudflare Turnstile check server-side (site key lives in
# src/turnstile.js). RATE_LIMIT_MAX is requests per IP per hour (default 60).
TURNSTILE_SECRET_KEY=
RATE_LIMIT_MAX=60
