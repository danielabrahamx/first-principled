# Copy to .env (gitignored) and fill in. Never commit .env.
# LLM_PROVIDER selects the live triple. Unset or openrouter uses LLM_*.
# deepseek uses DEEPSEEK_*. Prod stays OpenRouter; do not set Netlify
# LLM_PROVIDER=deepseek.
# JSON maps send thinking: false. OpenRouter uses reasoning effort none.
# DeepSeek uses thinking type disabled (its default is thinking on).
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Optional abuse controls (ticket 18). Set TURNSTILE_SECRET_KEY to enforce
# the Cloudflare Turnstile check server-side (site key lives in
# src/turnstile.js). RATE_LIMIT_MAX is requests per IP per hour (default 60).
TURNSTILE_SECRET_KEY=
RATE_LIMIT_MAX=60
